{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mezo.org/schemas/mdk-memory-entry.schema.json",
  "title": "MDK provider-neutral memory entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "domain",
    "status",
    "title",
    "summary",
    "sources",
    "related",
    "updated"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[/-][a-z0-9]+)*$",
      "maxLength": 120
    },
    "status": {
      "enum": [
        "discovered",
        "verified",
        "promoted",
        "deprecated"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "related": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "updated": {
      "type": "string",
      "format": "date"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "verified",
              "promoted"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "sources": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "promoted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "related": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
