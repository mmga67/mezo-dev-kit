{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mezo.org/schemas/mdk-agent-skill-catalog-v1.json",
  "title": "MDK agent skill catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "profile", "skills"],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "profile": { "const": "portable-agent-skills-v1" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "audience", "path", "domains"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^mdk-[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "audience": {
            "enum": ["contributor", "consumer"]
          },
          "path": {
            "type": "string",
            "pattern": "^agents/(skills|consumer/skills)/mdk-[a-z0-9-]+$"
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    }
  }
}
