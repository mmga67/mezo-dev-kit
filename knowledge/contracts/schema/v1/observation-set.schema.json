{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mezo contract observation set v1",
  "allOf": [
    {
      "$ref": "../../../schema/v0.4/common-envelope.schema.json"
    }
  ],
  "type": "object",
  "required": ["observedFrom", "observedThrough", "methodology", "networkSnapshots", "observations"],
  "properties": {
    "kind": { "const": "contract-observation-set" },
    "status": { "const": "verified" },
    "supportStatus": { "const": "none" },
    "reviewStatus": { "enum": ["pending-qualified-review", "accepted"] },
    "observedFrom": { "type": "string", "format": "date-time" },
    "observedThrough": { "type": "string", "format": "date-time" },
    "methodology": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "networkSnapshots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "deploymentId",
          "networkId",
          "observedAt",
          "observationBlock",
          "methods",
          "activation",
          "runtime",
          "proxy",
          "explorer",
          "outcome"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "deploymentId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[./@#-][a-z0-9]+)*$"
          },
          "networkId": { "type": "string", "minLength": 1 },
          "observedAt": { "type": "string", "format": "date-time" },
          "observationBlock": { "type": "object" },
          "methods": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "activation": { "type": "object" },
          "runtime": { "type": "object" },
          "proxy": { "type": ["object", "null"] },
          "explorer": { "type": "object" },
          "reproduction": { "type": "object" },
          "outcome": { "const": "passed" }
        },
        "additionalProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
