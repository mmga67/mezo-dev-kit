{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Full contract ABI artifact v1",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["type"],
    "properties": {
      "type": {
        "enum": ["constructor", "error", "event", "fallback", "function", "receive"]
      }
    },
    "additionalProperties": true
  }
}
