{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mezo transaction observation set v1",
  "allOf": [
    {"$ref": "../../../schema/v0.4/common-envelope.schema.json"}
  ],
  "type": "object",
  "required": ["observations"],
  "properties": {
    "kind": {"const": "mezo-transaction-observation-index"},
    "owner": {"const": "core-transactions"},
    "status": {"const": "verified"},
    "supportStatus": {"const": "none"},
    "reviewStatus": {"const": "pending-qualified-review"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "classification", "statement", "canonicalEvidence", "workflowConsequence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "classification": {"enum": ["external-fact", "observed-behavior"]},
          "statement": {"type": "string", "minLength": 1},
          "canonicalEvidence": {"type": "array", "minItems": 1},
          "workflowConsequence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  }
}
