  "scope": {"networkIds": ["mezo-mainnet", "mezo-testnet"], "protocolSourceCommit": "43ef44123753fa3e28425beffde42c86693fd03c"},
  "limitations": ["Governed parameters and deployment state must be read at an explicit block; this model does not freeze their values."],
  "claims": [
    {
      "id": "musd-classic-cdp-model",
      "statement": "The classic MUSD system issues a USD-denominated token through native BTC-collateralized troves and is derived from Threshold USD/Liquity architecture with Mezo-specific interest and PCV changes.",
      "classification": "external-fact",
      "stability": "versioned-design",
      "evidence": [
        {
          "sourceArtifactId": "docs-developer-guide",
          "locator": "introduction; Architectural Overview; Key Changes from THUSD",
          "establishes": "Published lineage and BTC-collateralized CDP model."
        },
        {
          "sourceArtifactId": "source-borrower-operations",
          "locator": "payable trove operations; MUSD mint/burn paths",
          "establishes": "Current native-collateral borrower entrypoints and issuance mechanics."
        }
      ],
      "limitations": [
        "This does not assert that every possible MUSD issuance domain is part of classic trove TCR.",
        "Marketing statements such as 100% backing are not encoded as accounting equalities."
      ]
    },
    {
      "id": "musd-active-custody",
      "statement": "Native BTC supplied through borrower operations is added to ActivePool's tracked collateral and remains in the pool system until an authorized protocol path transfers it.",
      "classification": "external-fact",
      "stability": "versioned-design",
      "evidence": [
        {
          "sourceArtifactId": "source-borrower-operations",
          "locator": "_openTrove and _adjustTrove collateral paths",
          "establishes": "Borrower operations forward native collateral into the pool system."
        },
        {
          "sourceArtifactId": "source-active-pool",
          "locator": "receive; sendCollateral",
          "establishes": "Tracked receipt and authorized outbound transfer behavior."
        },
        {
          "sourceArtifactId": "docs-architecture-terminology",
          "locator": "Contract Custody",
          "establishes": "Published high-level custody flow."
        }
      ]
    },
    {
      "id": "musd-accounted-not-raw-balances",
      "statement": "Pool collateral getters return protocol-maintained tracked balances, which need not equal a contract's raw native-currency balance after an unsolicited transfer.",
      "classification": "external-fact",
      "stability": "versioned-design",
      "evidence": [
        {
          "sourceArtifactId": "source-active-pool",
          "locator": "getCollateralBalance comment",
          "establishes": "ActivePool explicitly distinguishes tracked and raw balances."
        },
        {
          "sourceArtifactId": "source-coll-surplus-pool",
          "locator": "getCollateralBalance comment",
          "establishes": "The same distinction applies to surplus-pool accounting."
        }
      ]
    },
    {
      "id": "musd-system-aggregate-boundary",
      "statement": "Classic-trove entire system collateral is ActivePool tracked collateral plus DefaultPool tracked collateral; classic-trove entire system debt is ActivePool debt plus DefaultPool debt.",
      "classification": "external-fact",
      "stability": "versioned-design",
      "formula": {
        "entireSystemCollateral": "activePool.collateral + defaultPool.collateral",
        "entireSystemDebt": "activePool.debt + defaultPool.debt"
      },
      "evidence": [
        {
          "sourceArtifactId": "source-liquity-base",
          "locator": "getEntireSystemColl; getEntireSystemDebt",
          "establishes": "Exact aggregate composition."
        },
        {
          "sourceArtifactId": "docs-architecture-terminology",
          "locator": "Entire system collateral; Entire system debt",
          "establishes": "Published terminology."
        }
      ],
      "limitations": [
        "Do not silently merge another product's MUSD debt or collateral into TCR."
      ]
    },
    {
      "id": "musd-default-pool-redistribution",
      "statement": "Liquidation collateral, principal, and interest that are redistributed to active troves are accounted in DefaultPool until a trove operation applies the pending amounts and moves them into active accounting.",
      "classification": "external-fact",
      "stability": "versioned-design",
      "evidence": [
        {
          "sourceArtifactId": "source-default-pool",
          "locator": "contract comment; debt trackers; sendCollateralToActivePool",
          "establishes": "DefaultPool's unapplied redistribution role."
        },
        {
          "sourceArtifactId": "source-trove-manager",
          "locator": "RewardSnapshot; pending reward getters",
          "establishes": "Per-trove pending redistribution state."
        }
      ],
      "limitations": [
        "implementation review owns exact liquidation branching, reward calculations, and application rules."
      ]
    },
    {
      "id": "musd-stability-offset-model",
      "statement": "StabilityPool deposits can be burned to offset liquidated principal and interest while the associated native BTC collateral is transferred into StabilityPool accounting for depositor gains.",
      "classification": "external-fact",
      "stability": "versioned-design",
      "evidence": [
        {
          "sourceArtifactId": "source-stability-pool",
          "locator": "offset; _moveOffsetCollAndDebt; collateral-gain accounting",
          "establishes": "Current debt-offset and collateral accounting."
        },
        {
          "sourceArtifactId": "docs-developer-guide",
          "locator": "Protocol Bootstrap Loan & Stability Pool; Liquidation Flows",
          "establishes": "Published high-level offset model."
        }
      ],
      "limitations": [
        "implementation review owns eligibility, ordering, compensation, and partial/empty-pool behavior."
      ]
    },
    {
      "id": "musd-fixed-simple-interest",
      "statement": "A trove stores the annual rate assigned when it is opened or refinanced, and its interest accrues linearly on principal over elapsed time rather than compounding.",
      "classification": "external-fact",
      "stability": "versioned-design",
      "formula": {
        "conceptual": "principal * annualRateBps * elapsedSeconds / (10000 * secondsInYear)"
      },
      "evidence": [
        {
          "sourceArtifactId": "source-trove-manager",
          "locator": "Trove.interestRate; lastInterestUpdateTime; _getTotalDebt",
          "establishes": "Per-trove stored rate and timestamp."
        },
        {
          "sourceArtifactId": "source-interest-rate-math",
          "locator": "calculateInterestOwed",
          "establishes": "Current linear interest formula."
        },
        {
          "sourceArtifactId": "docs-architecture-terminology",
          "locator": "Fixed-Interest Borrowing",
          "establishes": "Published fixed simple-interest behavior and refinance exception."
        }
      ],
      "limitations": [
        "implementation review owns quote timing, rounding, refinancing, repayment allocation, and transaction semantics."
      ]
    },
    {
      "id": "musd-system-interest-accounting",
      "statement": "When aggregate system interest is materialized, InterestRateManager mints the amount to PCV and increases ActivePool interest debt by the same amount.",
      "classification": "external-fact",
      "stability": "versioned-design",
      "evidence": [
        {
          "sourceArtifactId": "source-interest-rate-manager",
          "locator": "updateSystemInterest",
          "establishes": "Matching MUSD mint and ActivePool debt increase."
        },
        {
          "sourceArtifactId": "source-active-pool",
          "locator": "increaseDebt; getInterest",
          "establishes": "Pool side of aggregate interest accounting."
        }
      ]
    },
    {
      "id": "musd-bootstrap-pcv-model",
      "statement": "PCV can initialize a protocol bootstrap loan by minting MUSD, recording the amount as debt to pay, and depositing the MUSD into StabilityPool; later PCV MUSD can burn that debt before excess protocol allocation.",
      "classification": "external-fact",
      "stability": "versioned-design",
      "evidence": [
        {
          "sourceArtifactId": "source-pcv",
          "locator": "initializeDebt; distributeMUSD; _repayDebt; _depositToStabilityPool",
          "establishes": "Current bootstrap and repayment mechanics at system-model level."
        },
        {
          "sourceArtifactId": "source-borrower-operations",
          "locator": "mintBootstrapLoanFromPCV; burnDebtFromPCV",
          "establishes": "Restricted token supply hooks used by PCV."
        },
        {
          "sourceArtifactId": "docs-architecture-terminology",
          "locator": "Protocol Bootstrap Loan",
          "establishes": "Published bootstrap intent."
        }
      ],
      "limitations": [
        "The current debt, split, recipients, and StabilityPool position are live state, not constants in this record."
      ]
    },
    {
      "id": "musd-sorted-position-model",
      "statement": "Active troves are indexed by borrower address in a descending linked list ordered by a price-independent nominal collateral ratio; state-changing integrations provide insertion hints, while HintHelpers can assist with approximate positions.",
      "classification": "external-fact",
      "stability": "versioned-design",
      "evidence": [
        {
          "sourceArtifactId": "source-sorted-troves",
          "locator": "contract comment; insert; reInsert",
          "establishes": "List identity, ordering, and hint behavior."
        },
        {
          "sourceArtifactId": "source-hint-helpers",
          "locator": "getApproxHint",
          "establishes": "Approximate read-only hint calculation."
        },
        {
          "sourceArtifactId": "docs-developer-guide",
          "locator": "Opening a Trove",
          "establishes": "Published integration requirement for hints."
        }
      ],
      "limitations": [
        "implementation review and implementation review own operation-specific hint construction and validation."
      ]
    },
    {
      "id": "musd-protocol-price-model",
      "statement": "MUSD collateral-ratio logic consumes a BTC/USD price from PriceFeed, which reads its configured external oracle, rejects stale observations under the current freshness bound, and normalizes the answer to 18-digit precision.",
      "classification": "external-fact",
      "stability": "versioned-design",
      "evidence": [
        {
          "sourceArtifactId": "source-price-feed",
          "locator": "fetchPrice; _scalePriceByDigits",
          "establishes": "Oracle read, freshness enforcement, and output precision."
        },
        {
          "sourceArtifactId": "source-liquity-base",
          "locator": "priceFeed; _getTCR; _checkRecoveryMode",
          "establishes": "Use of the protocol price in aggregate risk state."
        }
      ],
      "limitations": [
        "The bound and oracle address are versioned/deployment state and must not be inferred from a market-data fallback.",
        "Operational oracle incidents belong in implementation review after reproduction."
      ]
    },
    {
      "id": "musd-peg-mechanisms",
      "statement": "The published peg model combines MUSD-for-BTC redemption as downward-price arbitrage support with collateralized issuance as upward-price arbitrage support.",
      "classification": "external-fact",
      "stability": "stable-design",
      "evidence": [
        {
          "sourceArtifactId": "docs-user-overview",
          "locator": "How MUSD works",
          "establishes": "Published mint-and-redeem peg model."
        },
        {
          "sourceArtifactId": "docs-developer-guide",
          "locator": "Maintaining the Peg",
          "establishes": "Published developer explanation of the two arbitrage directions."
        },
        {
          "sourceArtifactId": "source-trove-manager",
          "locator": "redeemCollateral",
          "establishes": "Current redemption capability."
        },
        {
          "sourceArtifactId": "source-borrower-operations",
          "locator": "openTrove; withdrawMUSD",
          "establishes": "Current collateralized issuance capability."
        }
      ],
      "limitations": [
        "This is an economic mechanism, not a guarantee that market price always equals one USD.",
        "Exact collateral thresholds, fee bands, redemption ordering, and profitability examples belong to implementation review and implementation review."
      ]
    },
    {
      "id": "musd-governed-state-rule",
      "statement": "Initial values in Solidity are not authoritative current values for governable rates, limits, roles, recipients, splits, exemptions, or oracle bindings; current consumers must resolve the deployment and read the relevant state at an explicit block.",
      "classification": "architecture-rule",
      "stability": "stable-design",
