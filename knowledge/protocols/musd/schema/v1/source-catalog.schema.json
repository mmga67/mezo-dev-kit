{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MUSD source catalog v1",
  "allOf": [{"$ref": "../../../../schema/v0.4/common-envelope.schema.json"}],
  "type": "object",
  "required": ["protocolStatus", "sources", "artifacts"],
  "properties": {
    "kind": {"const": "musd-protocol-source-catalog"},
    "protocolStatus": {"const": "verified-versioned"},
    "sources": {"type": "array", "minItems": 1},
    "artifacts": {"type": "array", "minItems": 1}
  }
}
