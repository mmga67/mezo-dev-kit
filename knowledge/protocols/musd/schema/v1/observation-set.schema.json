{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MUSD protocol observation set v1",
  "allOf": [{"$ref": "../../../../schema/v0.4/common-envelope.schema.json"}],
  "type": "object",
  "required": ["observedAt", "method", "observations"],
  "properties": {
    "kind": {"const": "musd-protocol-read-observations"},
    "observedAt": {"type": "string", "format": "date-time"},
    "method": {"type": "string", "minLength": 1},
    "observations": {"type": "array", "minItems": 1}
  }
}
