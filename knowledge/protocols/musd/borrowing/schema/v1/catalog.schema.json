{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MUSD borrowing catalog or fixture v1",
  "allOf": [{"$ref": "../../../../../schema/v0.4/common-envelope.schema.json"}],
  "type": "object",
  "required": ["protocolStatus", "records"],
  "properties": {
    "kind": {"enum": ["musd-borrowing-position-model", "musd-borrowing-formula-catalog", "musd-borrowing-parameter-catalog", "musd-borrowing-operation-catalog", "musd-liquidation-model", "musd-borrowing-formula-fixtures"]},
    "protocolStatus": {"const": "verified-versioned"},
    "records": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}, "additionalProperties": true}}
  }
}
