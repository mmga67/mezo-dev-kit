{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mezo RPC endpoint catalog v1",
  "allOf": [
    {
      "$ref": "../../../schema/v0.4/common-envelope.schema.json"
    }
  ],
  "type": "object",
  "required": ["records"],
  "properties": {
    "kind": {
      "const": "rpc-endpoint-catalog"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "networkId",
          "provider",
          "transport",
          "url",
          "publicationStatus",
          "publicationSourceId",
          "supportStatus",
          "operationalStatus",
          "lastVerifiedAt",
          "evidenceObservationId",
          "limitations"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "networkId": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "transport": { "enum": ["https", "wss"] },
          "url": { "type": "string", "format": "uri" },
          "publicationStatus": { "enum": ["official", "official-recommended"] },
          "publicationSourceId": { "type": "string", "minLength": 1 },
          "supportStatus": { "enum": ["supported", "proposed", "docs-only"] },
          "operationalStatus": { "enum": ["verified", "failed-verification"] },
          "lastVerifiedAt": { "type": "string", "format": "date-time" },
          "evidenceObservationId": { "type": "string", "minLength": 1 },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
