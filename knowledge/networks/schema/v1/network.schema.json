{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mezo network record v1",
  "allOf": [
    {
      "$ref": "../../../schema/v0.4/common-envelope.schema.json"
    }
  ],
  "type": "object",
  "required": ["environment", "values", "claims"],
  "properties": {
    "kind": {
      "const": "network"
    },
    "environment": {
      "enum": ["mainnet", "testnet"]
    },
    "values": {
      "type": "object",
      "required": ["profile", "displayName", "evmChainId", "nativeCurrency", "explorer", "capabilities"],
      "properties": {
        "profile": {
          "enum": ["evm", "cosmos-evm"]
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "evmChainId": {
          "type": "integer",
          "minimum": 1
        },
        "cosmosChainId": {
          "type": "string",
          "minLength": 1
        },
        "nativeCurrency": {
          "type": "object",
          "required": ["name", "symbol", "decimals"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "symbol": { "type": "string", "minLength": 1 },
            "decimals": { "type": "integer", "minimum": 0 },
            "cosmosEvmDenom": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "explorer": {
          "type": "object",
          "required": ["name", "url"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" }
          },
          "additionalProperties": false
        },
        "capabilities": {
          "type": "object",
          "required": ["evm", "evmJsonRpc", "gasCurrency"],
          "properties": {
            "evm": { "const": true },
            "evmJsonRpc": { "const": true },
            "cosmosSdk": { "type": "boolean" },
            "nodeCosmosRpc": { "type": "boolean" },
            "consensusEngine": { "type": "string", "minLength": 1 },
            "gasCurrency": { "const": "native" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "profile": { "const": "cosmos-evm" } },
            "required": ["profile"]
          },
          "then": {
            "required": ["cosmosChainId"],
            "properties": {
              "nativeCurrency": { "required": ["cosmosEvmDenom"] },
              "capabilities": {
                "required": ["cosmosSdk", "nodeCosmosRpc", "consensusEngine"],
                "properties": {
                  "cosmosSdk": { "const": true },
                  "nodeCosmosRpc": { "const": true }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "profile": { "const": "evm" } },
            "required": ["profile"]
          },
          "then": {
            "properties": {
              "cosmosChainId": false,
              "nativeCurrency": {
                "properties": { "cosmosEvmDenom": false }
              },
              "capabilities": {
                "properties": {
                  "cosmosSdk": false,
                  "nodeCosmosRpc": false,
                  "consensusEngine": false
                }
              }
            }
          }
        }
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "statement", "classification", "disposition", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "classification": { "const": "external-fact" },
          "disposition": { "const": "promote" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["sourceId", "locator", "note"],
              "properties": {
                "sourceId": { "type": "string", "minLength": 1 },
                "locator": { "type": "string", "minLength": 1 },
                "note": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
