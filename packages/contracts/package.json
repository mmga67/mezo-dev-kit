{
  "name": "@mezo-dev-kit/contracts",
  "version": "0.0.0-private",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Private read-only MDK contract deployment and ABI resolver generated from canonical knowledge.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/workspace/clean-package-dist.ts contracts && tsc --project tsconfig.build.json",
    "check": "pnpm format:check && pnpm generate:check && pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "format:check": "prettier --check src test tools README.md vitest.config.ts package.json tsconfig.json tsconfig.build.json",
    "generate": "pnpm --filter @mezo-dev-kit/evm build && node ../../scripts/generate/generate-contracts-package.ts",
    "generate:check": "pnpm --filter @mezo-dev-kit/evm build && node ../../scripts/generate/generate-contracts-package.ts --check",
    "lint": "eslint src test tools vitest.config.ts",
    "test": "vitest run",
    "test:shuffle": "vitest run --sequence.shuffle --sequence.seed=56012",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@mezo-dev-kit/evm": "workspace:*",
    "@mezo-dev-kit/chains": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "README.md",
    "REFERENCE.md",
    "LICENSE"
  ],
  "sideEffects": false
}
