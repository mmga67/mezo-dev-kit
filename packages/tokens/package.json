{
  "name": "@mezo-dev-kit/tokens",
  "version": "0.0.0-private",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Explicit ERC-20 balance, allowance and approval workflows.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.ts tokens && tsc --project tsconfig.build.json",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "format:check": "prettier --check src test vitest.config.ts package.json tsconfig.json tsconfig.build.json",
    "lint": "eslint src test vitest.config.ts",
    "test": "vitest run",
    "test:shuffle": "vitest run --sequence.shuffle --sequence.seed=45001",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@mezo-dev-kit/evm": "workspace:*",
    "@mezo-dev-kit/chains": "workspace:*",
    "@mezo-dev-kit/contracts": "workspace:*",
    "@mezo-dev-kit/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
