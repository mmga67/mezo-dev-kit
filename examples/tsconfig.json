      "@mezo-dev-kit/swaps": ["../packages/swaps/src/index.ts"],
      "@mezo-dev-kit/bridges": ["../packages/bridges/src/index.ts"],
      "@mezo-dev-kit/musd-savings": ["../packages/protocols/musd-savings/src/index.ts"],
