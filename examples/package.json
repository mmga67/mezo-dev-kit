{
  "name": "@mezo-dev-kit/examples",
  "version": "0.0.0-private",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Runnable MDK workflows with explicit local execution and settlement.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../scripts/workspace/clean-package-dist.ts examples && tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:shuffle": "vitest run --sequence.shuffle --sequence.seed=78001",
    "test:built": "tsc --project tsconfig.built.json && node test/foundations.ts && node test/built/index.ts",
    "borrow-musd": "node dist/cli.js borrow-musd",
    "provide-basic-liquidity": "node dist/cli.js provide-basic-liquidity",
    "swap-tokens": "node dist/cli.js swap-tokens",
    "bridge-musd": "node dist/cli.js bridge-musd",
    "save-musd": "node dist/cli.js save-musd",
    "lend-and-borrow-musdc": "node dist/cli.js lend-and-borrow-musdc",
    "use-usdc-vault": "node dist/cli.js use-usdc-vault",
    "manage-cl-position": "node dist/cli.js manage-cl-position",
    "lock-and-vote": "node dist/cli.js lock-and-vote",
    "redeem-musd": "node dist/cli.js redeem-musd",
    "resume": "node dist/cli.js resume",
    "foundations": "node dist/foundations.js"
  },
  "dependencies": {
    "@mezo-dev-kit/evm": "workspace:*",
    "@mezo-dev-kit/chains": "workspace:*",
    "@mezo-dev-kit/contracts": "workspace:*",
    "@mezo-dev-kit/core": "workspace:*",
    "@mezo-dev-kit/tokens": "workspace:*",
    "@mezo-dev-kit/musd-borrowing": "workspace:*",
    "@mezo-dev-kit/pools": "workspace:*",
    "@mezo-dev-kit/swaps": "workspace:*",
    "@mezo-dev-kit/bridges": "workspace:*",
    "@mezo-dev-kit/musd-savings": "workspace:*",
    "@mezo-dev-kit/musdc-lending": "workspace:*",
    "@mezo-dev-kit/usdc-lending-vault": "workspace:*",
    "@mezo-dev-kit/incentives": "workspace:*",
    "@mezo-dev-kit/musd-redemptions": "workspace:*",
    "@mezo-dev-kit/prices": "workspace:*",
    "@mezo-dev-kit/musd-institutional-debt": "workspace:*",
    "@mezo-dev-kit/cli": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
