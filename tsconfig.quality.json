{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@mezo-dev-kit/evm": ["./packages/evm/src/index.ts"],
      "@mezo-dev-kit/cli": ["./packages/cli/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "vitest.quality.config.ts", "vitest.browser.config.ts"],
  "exclude": ["scripts/fixtures/coding-gates/**"]
}
