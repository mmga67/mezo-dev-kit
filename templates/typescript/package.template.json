{
  "name": "mdk-application",
  "version": "0.1.0",
  "private": true,
  "mdkStarter": "typescript",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": { "node": ">=24" },
  "scripts": {
    "mdk": "mdk",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && mdk sync --locked --check --offline"
  },
  "dependencies": {
    "@mezo-dev-kit/evm": "workspace:*",
    "@mezo-dev-kit/chains": "workspace:*",
    "@mezo-dev-kit/contracts": "workspace:*",
    "@mezo-dev-kit/core": "workspace:*"
  },
  "devDependencies": {
    "@mezo-dev-kit/cli": "workspace:*",
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
